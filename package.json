{
  "name": "openzeus",
  "version": "1.1.0",
  "description": "OpenCode operator kit with agents, skills, commands, and safe sync utilities",
  "main": "bin/openzeus",
  "keywords": [
    "opencode",
    "ai-agent", 
    "configuration",
    "automation",
    "skills",
    "commands",
    "zeus",
    "ai-assistant",
    "code-generation"
  ],
  "author": "OpenZeus Project <https://github.com/Aveer/OpenZeus>",
  "license": "MIT",
  "homepage": "https://github.com/Aveer/OpenZeus#readme",
  "bugs": {
    "url": "https://github.com/Aveer/OpenZeus/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aveer/OpenZeus.git"
  },
  "files": [
    "bin/",
    "agents/",
    "skills/",
    "commands/",
    "docs/",
    "scripts/",
    "tests/"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "test": "bash -n scripts/install.sh scripts/sync-utils.sh scripts/create-utils.sh scripts/setup-hooks.sh scripts/doctor.sh bin/openzeus && tests/run.sh"
  },
  "bin": {
    "openzeus": "bin/openzeus"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "preferGlobal": true
}
