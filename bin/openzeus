#!/bin/bash
set -euo pipefail

resolve_root() {
  local source="${BASH_SOURCE[0]}" dir=""
  while [[ -L "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" == /* ]] || source="$dir/$source"
  done
  cd -P "$(dirname "$source")/.." && pwd
}

SCRIPT_DIR="$(resolve_root)"

node_bin() {
  local resolved="${OPENZEUS_NODE:-${npm_node_execpath:-}}"
  if [[ -z "$resolved" ]]; then
    resolved="$(command -v node 2>/dev/null || true)"
  fi
  [[ -n "$resolved" ]] || { echo "OpenZeus requires Node.js for this command" >&2; exit 1; }
  printf '%s\n' "$resolved"
}

usage() {
  cat <<EOF
OpenZeus CLI

Usage: openzeus <audit|inspect|install-agent|create|validate|examples|help> [args...]

Commands:
  audit          Summarize actionable OpenCode findings
  inspect        Inventory filesystem-visible OpenCode sources and precedence
  install-agent  Install only the @OpenZeus agent file
  create         Create an OpenCode agent, skill, or command template
  validate       Validate OpenZeus/OpenCode asset structure
  examples       Show common OpenZeus workflows

The five focused Zeus skills and live runtime tool are provided by the native
OpenCode V2 plugin. Manage it with:
  opencode plugin add openzeus
  opencode plugin list
  opencode plugin update openzeus
  opencode plugin remove openzeus
EOF
}

examples() {
  cat <<EOF
Bootstrap after the OpenZeus 2 package is published:
  opencode plugin add openzeus
  openzeus install-agent

Diagnostics:
  openzeus audit
  openzeus audit --json
  openzeus inspect --json

Authoring:
  openzeus create skill release-workflow "Use for release preparation and validation"
  openzeus create agent reviewer "Reviews changes for correctness"
  openzeus create command release-notes "Draft release notes"

OpenCode prompts:
  @OpenZeus audit my OpenCode setup and explain what to fix
  @OpenZeus where did this skill come from?
  @OpenZeus migrate this old agent to current OpenCode
  @OpenZeus design a portable skill for this workflow
EOF
}

case "${1:-help}" in
  audit) exec "$(node_bin)" "$SCRIPT_DIR/scripts/audit.mjs" "${@:2}" ;;
  inspect) exec "$(node_bin)" "$SCRIPT_DIR/scripts/inspect.mjs" "${@:2}" ;;
  install-agent) exec "$SCRIPT_DIR/scripts/install-agent.sh" "${@:2}" ;;
  install)
    echo "WARN: 'openzeus install' is deprecated; installing only the agent bootstrap." >&2
    exec "$SCRIPT_DIR/scripts/install-agent.sh" "${@:2}"
    ;;
  create) exec "$SCRIPT_DIR/scripts/create-utils.sh" "${@:2}" ;;
  validate) exec "$SCRIPT_DIR/scripts/validate.sh" "${@:2}" ;;
  examples) examples ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: ${1:-}" >&2; usage >&2; exit 1 ;;
esac
